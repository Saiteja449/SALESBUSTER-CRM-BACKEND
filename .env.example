# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/salesbuster_master
MASTER_DB_NAME=salesbuster_master

# Authentication
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
GEMINI_FINAL_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash

# Audio Storage & Streaming Controls
AUDIO_STORAGE_PATH=./uploads/voice
MAX_RECORDING_DURATION=1800
AUDIO_CHUNK_SIZE=1024
AUDIO_CHUNK_TIMEOUT=5000

# AI Processing Timeouts (ms)
TRANSCRIPTION_TIMEOUT=30000
EXTRACTION_TIMEOUT=15000
SUMMARY_TIMEOUT=15000

